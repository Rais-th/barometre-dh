# Database (Vercel Postgres or Neon in production)
# For local dev this can point to SQLite via file: url if Prisma provider is switched.
DATABASE_URL="postgresql://user:password@localhost:5432/barometre"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Vercel Blob (for encrypted evidence uploads)
BLOB_READ_WRITE_TOKEN=""

# Resend for case assignment emails
RESEND_API_KEY=""
RESEND_FROM="Baromètre DH <no-reply@barometre-dh.org>"

# App-side encryption key for case PII. 32 raw bytes, base64-encoded.
# Generate with: openssl rand -base64 32
CASE_ENCRYPTION_KEY=""

# Seed defaults (optional). First admin account created at `prisma db seed`.
SEED_ADMIN_EMAIL="admin@dignitehumaine.org"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="La Dignité Humaine"
